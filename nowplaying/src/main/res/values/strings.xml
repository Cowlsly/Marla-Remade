<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name displayed in launcher -->
    <string name="app_name">Now Playing</string>

    <!-- Permission wall: button and title shown when the microphone has not been granted yet. Verb phrase. -->
    <string name="grant_microphone_permission">Grant microphone access</string>

    <!-- ListenScreen: status when music is currently being heard. Noun phrase. -->
    <string name="status_music">Music detected</string>
    <!-- ListenScreen: explanation under "Music detected". Makes clear the app does not name songs. -->
    <string name="status_music_hint">Something is playing nearby. This app does not identify which song.</string>
    <!-- ListenScreen: status while listening but hearing no music. Noun phrase. -->
    <string name="status_silent">No music</string>
    <!-- ListenScreen: explanation under "No music". -->
    <string name="status_silent_hint">Listening. Nothing musical right now.</string>
    <!-- ListenScreen: status when listening is switched off. Adjective phrase. -->
    <string name="status_idle">Not listening</string>
    <!-- ListenScreen: explanation under "Not listening". -->
    <string name="status_idle_hint">Turn on listening to start detecting music.</string>
    <!-- ListenScreen: status when the detection model could not be loaded. Adjective phrase. -->
    <string name="status_unavailable">Detector unavailable</string>
    <!-- ListenScreen: explanation under "Detector unavailable". -->
    <string name="status_unavailable_hint">The music model could not be loaded, so detection is off.</string>

    <!-- ListenScreen: label of the switch that turns always-on listening on and off. Verb phrase. -->
    <string name="listen_toggle">Listen for music</string>
    <!-- ListenScreen: explanation under the listening switch. Reassures the user about privacy. -->
    <string name="listen_toggle_hint">Audio is analysed on your device and never recorded or sent anywhere.</string>

    <!-- ListenScreen: heading above the list of past detections. Noun. -->
    <string name="history_header">History</string>
    <!-- ListenScreen: shown in place of the history list when nothing has been detected yet. -->
    <string name="history_empty">No music detected yet</string>
    <!-- ListenScreen: explanation under "No music detected yet". -->
    <string name="history_empty_hint">Stretches of music will be listed here as they are heard.</string>
    <!-- ListenScreen: history row for a finished detection. %1$s and %2$s are clock times. -->
    <string name="history_range"><xliff:g id="start_time" example="14:02">%1$s</xliff:g> – <xliff:g id="end_time" example="14:09">%2$s</xliff:g></string>
    <!-- ListenScreen: history row for music that is still playing. %1$s is a clock time. -->
    <string name="history_range_ongoing"><xliff:g id="start_time" example="14:02">%1$s</xliff:g> – now</string>
    <!-- ListenScreen: second line of a history row. %1$s is a date, %2$d is a percentage 0-100. -->
    <string name="history_supporting"><xliff:g id="date" example="5 Sep 2026">%1$s</xliff:g> · <xliff:g id="confidence" example="87">%2$d</xliff:g>%% confidence</string>

    <!-- Notification channel name for the always-on listening service, shown in system settings. -->
    <string name="listening_channel_name">Listening</string>
    <!-- Notification channel description, shown in system settings. -->
    <string name="listening_channel_desc">Shown while the microphone is being used to detect music.</string>
    <!-- Title of the ongoing notification while listening. Verb phrase. -->
    <string name="listening_notification_title">Listening for music</string>
    <!-- Body of the ongoing notification while listening. -->
    <string name="listening_notification_text">Audio stays on this device.</string>
</resources>
