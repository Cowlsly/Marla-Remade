<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="external" />
        <exclude domain="file" path="vectortilecache/" />
        <exclude domain="file" path="tilecache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" />
        <exclude domain="file" path="vectortilecache/" />
        <exclude domain="file" path="tilecache/" />
    </device-transfer>
</data-extraction-rules>
