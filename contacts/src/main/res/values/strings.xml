<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name displayed in launcher -->
    <string name="app_name">Contacts</string>

    <!-- ContactDetailsPage: details screen -->
    <!-- Error/empty state when contact id not found in provider -->
    <string name="contact_not_found">Contact not found</string>
    <!-- Display name format combining name and nickname, used in list rows. %1$s = full name, %2$s = nickname -->
    <string name="name_nickname_format"><xliff:g id="name" example="John Doe">%1$s</xliff:g> (<xliff:g id="nickname" example="Johnny">%2$s</xliff:g>)</string>
    <!-- Content description for contact avatar image: accessibility. %1$s = contact name -->
    <string name="contact_photo_description"><xliff:g id="contact_name" example="John Doe">%1$s</xliff:g> photo</string>
    <!-- Action to share contact as VCF via chooser. Chooser title. -->
    <string name="share_contact">Share Contact</string>
    <!-- Section header: details about person. %1$s = first name -->
    <string name="about_name">About <xliff:g id="first_name" example="John">%1$s</xliff:g></string>
    <!-- Field label for birthday date -->
    <string name="birthday">Birthday</string>
    <!-- Section header and field label for freeform notes -->
    <string name="note">Note</string>
    <!-- ContactList: section header above starred contacts -->
    <string name="favorites">Favorites</string>
    <!-- Settings: button to export all contacts to VCF file -->
    <string name="export_contacts">Export all contacts</string>
    <!-- Fallback account name meaning local on-device storage, not synced -->
    <string name="on_device">On-Device</string>
    <!-- TopAppBar title for creating new contact -->
    <string name="add_contact">Add contact</string>
    <!-- TopAppBar title for editing existing contact -->
    <string name="edit_contact">Edit contact</string>
    <!-- Text field label for first/given name -->
    <string name="first_name">First name</string>
    <!-- Text field label for middle name -->
    <string name="middle_name">Middle name</string>
    <!-- Text field label for last/family name -->
    <string name="last_name">Last name</string>
    <!-- Text field label for nickname -->
    <string name="nickname">Nickname</string>
    <!-- Text field label for company/organization name -->
    <string name="company">Company</string>
    <!-- Field label and picker for contacts account (e.g. Google, Local) -->
    <string name="account">Account</string>
    <!-- Account picker dropdown item format. %1$s = account name or On-Device, %2$s = account type -->
    <string name="account_display_format"><xliff:g id="account_name" example="Personal">%1$s</xliff:g> (<xliff:g id="account_type" example="com.google">%2$s</xliff:g>)</string>
    <!-- Button below phone section to add another phone number. Verb. -->
    <string name="add_phone">Add phone</string>
    <!-- Button/accessibility to remove phone field entry. Verb. -->
    <string name="remove_phone">Remove phone</string>
    <!-- Button to add another email address -->
    <string name="add_email">Add email</string>
    <!-- Button to remove email field entry -->
    <string name="remove_email">Remove email</string>
    <!-- Button to add another postal address -->
    <string name="add_address">Add address</string>
    <!-- Button to remove address field entry -->
    <string name="remove_address">Remove address</string>
    <!-- Button to add another date (e.g. anniversary) -->
    <string name="add_date">Add date</string>
    <!-- Section header for other important dates -->
    <string name="dates">Dates</string>
    <!-- Field label and section header for phone numbers -->
    <string name="phone">Phone</string>
    <!-- Field label and section header for email addresses -->
    <string name="email">Email</string>
    <!-- Section header for postal addresses -->
    <string name="addresses">Addresses</string>
    <!-- Content description for contact photo placeholder/avatar when viewing -->
    <string name="contact_photo">Contact photo</string>
    <!-- Button below avatar to add a photo when none exists -->
    <string name="add_picture">Add picture</string>
    <!-- Button to change existing contact photo. Short, verb. Keep short -->
    <string name="change_picture">Change</string>
    <!-- Button to remove contact photo -->
    <string name="remove_picture">Remove</string>

    <!-- SettingsPage -->
    <!-- Settings section header: which accounts are visible in list -->
    <string name="visible_accounts">Visible Accounts</string>
    <!-- Settings button to add a new local contacts account -->
    <string name="add_contacts_account">Add Contacts Account</string>
    <!-- Dialog prompt to enter name for new local account -->
    <string name="enter_account_name">Enter a name for the new local account:</string>
    <!-- Text field label for account name input -->
    <string name="account_name">Account Name</string>

    <!-- Delete contact flow -->
    <!-- Dialog title for delete single contact confirmation -->
    <string name="delete_contact_title">Delete contact</string>
    <!-- Confirmation message for deleting contact without showing name -->
    <string name="delete_contact_confirm">Are you sure you want to delete this contact? This action cannot be undone.</string>
    <!-- Confirmation message with contact name quoted. %1$s = contact display name -->
    <string name="delete_contact_name_confirm">Are you sure you want to delete \"<xliff:g id="contact_name" example="John Doe">%1$s</xliff:g>\"? This action cannot be undone.</string>

    <!-- MainActivity permissions and hints -->
    <!-- Permission screen message when contacts permission not granted -->
    <string name="grant_contacts_permission">Please grant contacts permission</string>
    <!-- Two-pane layout hint on tablets: prompt to select contact from list -->
    <string name="select_contact_hint">Select a contact to view details</string>

    <!-- Import / Export VCF -->
    <!-- Settings and screen title for importing contacts from VCF -->
    <string name="import_contacts">Import Contacts</string>
    <!-- Quick action chip: call contact. Verb. -->
    <string name="action_call">Call</string>
    <!-- Quick action chip: message contact. Verb. -->
    <string name="action_message">Message</string>
    <!-- Quick action chip: video call contact. Noun/Verb. -->
    <string name="action_video">Video</string>
    <!-- Settings section header for calendar sync of birthdays -->
    <string name="calendar_sync">Calendar Sync</string>
    <!-- Settings row: toggle to show contact birthdays in calendar app -->
    <string name="sync_contacts_calendar">Show birthdays in calendar</string>
    <!-- Calendar name used when creating contacts birthday calendar -->
    <string name="contacts_calendar_name">Contacts</string>
    <!-- Field label for anniversary date -->
    <string name="anniversary">Anniversary</string>
    <!-- Settings section header for backup options -->
    <string name="backup_and_export">Backup and Export</string>
    <!-- Settings button when calendar permissions needed for birthday sync -->
    <string name="grant_calendar_permissions">Grant calendar permissions</string>
    <!-- Dialog title for deleting multiple selected contacts -->
    <string name="delete_selected_contacts_title">Delete selected contacts</string>
    <!-- Confirmation for bulk delete. %1$d = number of selected contacts -->
    <plurals name="delete_selected_contacts_confirm">
        <item quantity="one">Are you sure you want to delete the <xliff:g id="count" example="5">%1$d</xliff:g> selected contact? This action cannot be undone.</item>
        <item quantity="other">Are you sure you want to delete the <xliff:g id="count" example="5">%1$d</xliff:g> selected contacts? This action cannot be undone.</item>
    </plurals>
    <!-- Top bar title in multi-select mode showing selection count. %1$d = count -->
    <string name="selected_count"><xliff:g id="count" example="3">%1$d</xliff:g> selected</string>
    <!-- Settings section header for display preferences -->
    <string name="display">Display</string>
    <!-- Settings toggle: show account label chips in contact list -->
    <string name="show_account_labels">Show contact accounts</string>
    <!-- Search bar hint text to filter contacts -->
    <string name="search_contacts">Search contacts</string>
    <!-- EventDatePickerDialog: toggle whether year is included for birthday (yearless birthdays) -->
    <string name="include_year">Include year</string>
    <!-- Dropdown option: use system default app for calling/messaging -->
    <string name="system_default">System Default</string>
    <!-- App label: Signal messenger -->
    <string name="signal">Signal</string>
    <!-- App label: WhatsApp messenger -->
    <string name="whatsapp">WhatsApp</string>
    <!-- App label: Telegram messenger -->
    <string name="telegram">Telegram</string>
    <!-- App label: Google Meet video calling -->
    <string name="google_meet">Google Meet</string>

    <!-- Bottom navigation -->
    <!-- Bottom nav label: contacts list tab -->
    <string name="contacts">Contacts</string>
    <!-- Bottom nav label: groups tab -->
    <string name="groups">Groups</string>
    <!-- Two-pane hint for groups screen on tablets -->
    <string name="select_group_hint">Select a group to view contacts</string>

    <!-- Groups management -->
    <!-- Dialog title and action to add selected contacts to a group -->
    <string name="add_to_group">Add to Group</string>
    <!-- Dialog title and button to create new group -->
    <string name="add_group">Add Group</string>
    <!-- Hint text for group name input field -->
    <string name="enter_group_name">Enter group name</string>
    <!-- Dialog title for deleting a group -->
    <string name="delete_group_title">Delete group</string>
    <!-- Confirmation message for deleting group, contacts not deleted -->
    <string name="delete_group_confirm">Are you sure you want to delete this group? The contacts will not be deleted.</string>

    <!-- Import VCF screen and common toasts -->
    <!-- Empty state for groups screen when no groups exist -->
    <string name="no_groups_found">No groups found. Create one in the Groups tab.</string>
    <!-- Settings row and header: import .vcf file for contacts -->
    <string name="import_vcf_file">Import .vcf file</string>
    <!-- Import flow: option to import into existing account -->
    <string name="import_to_existing_account">Import to existing account</string>
    <!-- Import flow: option to create new account for imported contacts -->
    <string name="create_new_account_option">Create new account</string>
    <!-- Empty state when VCF file contains no contacts -->
    <string name="no_contacts_found">No contacts found</string>
    <!-- Summary showing number of contacts parsed from VCF ready to import. %1$d = contact count -->
    <plurals name="import_summary_contacts">
        <item quantity="one"><xliff:g id="count" example="10">%1$d</xliff:g> contact ready to import</item>
        <item quantity="other"><xliff:g id="count" example="10">%1$d</xliff:g> contacts ready to import</item>
    </plurals>
    <!-- Dialog title: select account from list -->
    <string name="select_account">Select account</string>
    <!-- Placeholder when contact has no name -->
    <string name="no_name">(No name)</string>
    <!-- Contacts count label in account section. %1$d = number of contacts -->
    <plurals name="contacts_count">
        <item quantity="one"><xliff:g id="count" example="42">%1$d</xliff:g> contact</item>
        <item quantity="other"><xliff:g id="count" example="42">%1$d</xliff:g> contacts</item>
    </plurals>
    <!-- Action when incoming call from unknown number: add number to existing contact -->
    <string name="add_number_to_contact">Add number to contact</string>
    <!-- Action when incoming call from unknown number: create brand new contact -->
    <string name="create_new_contact">Create new contact</string>

    <!-- CropPhotoScreen -->
    <!-- TopAppBar title for cropping contact photo -->
    <string name="crop_photo">Crop Photo</string>
    <!-- Settings: row label for importing contacts from VCF files -->
    <string name="import_contacts_from_vcf_files">Import contacts from .vcf files</string>

    <!-- Custom label support -->
    <!-- Label for custom label text field -->
    <string name="custom_label">Custom label</string>
    <!-- Placeholder / description for entering custom label -->
    <string name="enter_custom_label">Enter custom label</string>

    <!-- SIM contacts (now virtual accounts) -->
    <string name="sim_limited_fields_hint">SIM contacts only store name, phone, and email.</string>
    <string name="save_failed">Save failed</string>
    <string name="importing">Importing…</string>
</resources>
