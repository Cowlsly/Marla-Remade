<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.READ_CONTACTS" android:maxSdkVersion="36"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Find Nearby (UWB) screen uses the public android.ranging API
         introduced in Android 15. We do not depend on androidx.core.uwb
         (its only backend is GMS, which is broken on GrapheneOS), and
         consequently do not declare UWB_RANGING. -->
    <uses-permission android:name="android.permission.RANGING" />
    <uses-feature android:name="android.hardware.uwb" android:required="false" />

    <permission
        android:name="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:backupAgent=".util.AppBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep-link invite: findfamily://add/<base26Userid>. Carries only the
                 sender's public id; tapping prefills the Add Person dialog. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="findfamily" android:host="add" />
            </intent-filter>
        </activity>

        <service
            android:name=".util.LocationTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Live family-location channel for co-signed apps (the maps app binds
             this while its map screen is open). Guarded by the signature
             permission below so only apps signed with the same key can bind. -->
        <service
            android:name=".ipc.FamilyLocationService"
            android:exported="true"
            android:permission="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY">
            <intent-filter>
                <action android:name="com.vayunmathur.findfamily.action.FAMILY_LOCATIONS" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile to turn location tracking on/off (GitHub #487). -->
        <service
            android:name=".util.TrackingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_tracking"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVITY"
                android:value=".MainActivity" />
        </service>


        <receiver android:name=".util.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".intents.GetIntent"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:permission="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY">
        </activity>

        <activity
            android:name=".intents.CreateLinkIntent"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:permission="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY">
        </activity>
    </application>

</manifest>