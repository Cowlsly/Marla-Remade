menu "FindFamily tracker"

config FF_TRACKER_UWB
	bool "Build the UWB (FiRa responder) path"
	default n
	help
	  Compile src/tracker_sts.c and src/tracker_uwb.c, which run a FiRa
	  responder/controlee session on the DW3110. Off by default because it needs
	  the licensed Qorvo DW3xxx driver, which is not vendored in this tree — the
	  BLE crowd-finding image builds and flashes without it. See README.md.

config FF_TRACKER_BEACON_INTERVAL_MS
	int "Beacon advertising interval (ms)"
	default 1000
	range 100 10000
	help
	  Extended-advertising interval for the rotating epoch-id beacon. The tradeoff is
	  battery against how quickly a passing finder phone hears the tracker; 1 s is
	  roughly what commercial trackers use.

config FF_TRACKER_PAIRING_TIMEOUT_S
	int "Pairing-mode timeout (seconds)"
	default 120
	range 10 600
	help
	  How long an unprovisioned-service advertisement runs after a long button press
	  before falling back to the previous mode. Bounds the window in which anything
	  nearby could claim an already-bound tracker.

endmenu

source "Kconfig.zephyr"
