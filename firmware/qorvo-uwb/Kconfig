config QORVO_UWB
	bool "Qorvo DW3xxx / QM33 UWB stack"
	select SPI
	select GPIO
	select POLL
	# The stack's frame protection (CCM*, CMAC key derivation, ECB header IEs) runs on
	# PSA via src/mcps_crypto_psa.c.
	select PSA_CRYPTO
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_ALG_CMAC
	select PSA_WANT_ALG_CCM
	select PSA_WANT_ALG_ECB_NO_PADDING
	select PSA_WANT_GENERATE_RANDOM
	help
	  Build the Qorvo DW3xxx driver, the Zephyr qosal/qhal backends and link the
	  prebuilt FiRa uwbstack bundle. Requires the licensed DW3_QM33 SDK, which is
	  not vendored here — point QORVO_SDK_DIR at an extracted copy. See
	  firmware/qorvo-uwb/README.md.

if QORVO_UWB

config QORVO_UWB_SPI_FREQ_SLOW_HZ
	int "SPI frequency used before the device is identified (Hz)"
	default 4000000
	help
	  The DW3000 requires <= 7 MHz until it has left INIT state, per Qorvo's
	  driver notes. 4 MHz is what the vendor SDK uses.

config QORVO_UWB_SPI_FREQ_FAST_HZ
	int "SPI frequency used once the device is up (Hz)"
	default 8000000
	help
	  The DW3000 tolerates up to 38 MHz, but this is also capped by the dw3110 node's
	  spi-max-frequency, and 32 MHz only works at all on nRF52833's SPIM3. 8 MHz is
	  plenty — nothing about ranging is bottlenecked on register access — and it avoids
	  a class of signal-integrity problems that only appear once traffic gets real.

config QORVO_UWB_QLOG_LEVEL
	int "Log level passed to the Qorvo stack as CONFIG_QLOG_LEVEL"
	default 2
	range 0 4
	help
	  Qorvo's own scale, which is NOT Zephyr's: 0=off 1=error 2=info 3=debug 4=trace.
	  The stack filters its own logs with this and routes them through the Zephyr
	  logging backend. The Zephyr-side level for this module's own sources is
	  QORVO_UWB_LOG_LEVEL below, where 2 means warning rather than info.

module = QORVO_UWB
module-str = Qorvo UWB
source "subsys/logging/Kconfig.template.log_config"

endif # QORVO_UWB
