<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Manifest / TopAppBar: App name. Noun, proper -->
    <string name="app_name" translatable="false">Nonogram</string>

    <!-- GameModeDropdown: Mode playing the numbered level progression. Adjective -->
    <string name="mode_casual">Levels</string>
    <!-- GameModeDropdown: Mode playing today's shared puzzle. Adjective -->
    <string name="mode_daily">Daily</string>

    <!-- NonogramGameScreen TopAppBar: Current level in the progression. %1$d = level number, e.g. 12 -->
    <string name="level_title">Level <xliff:g id="level" example="12">%1$d</xliff:g></string>
    <!-- NonogramGameScreen: Button advancing to the next level after a win. Verb phrase -->
    <string name="next_level">Next Level</string>
    <!-- NonogramGameScreen: Clears every mark on the current puzzle. Verb -->
    <string name="restart">Restart</string>
    <!-- NonogramGameScreen: Shown after finishing the daily, since there is only one per day. Sentence -->
    <string name="daily_come_back_tomorrow">Solved! Come back tomorrow for a new puzzle.</string>
    <!-- NonogramGameScreen: Celebratory line shown when a level is completed. Declarative -->
    <string name="solved">Solved!</string>
    <!-- DailyStatusBar: Current daily streak length. %1$d = consecutive days, e.g. 5 -->
    <string name="daily_streak">Streak: <xliff:g id="days" example="5">%1$d</xliff:g></string>
    <!-- NonogramGameScreen: Hint under a fresh board explaining the two gestures. Imperative sentence -->
    <string name="how_to_play">Tap to fill, long press to cross out</string>
    <!-- NonogramGameScreen: Shown when the last heart is spent. Declarative, sympathetic -->
    <string name="out_of_hearts">Out of hearts!</string>

    <!-- NonogramGameScreen: Content description of the hearts remaining. %1$d = hearts left, 0 to 3, e.g. 2 -->
    <plurals name="cd_hearts">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> heart left</item>
        <item quantity="other"><xliff:g id="count" example="2">%1$d</xliff:g> hearts left</item>
    </plurals>

    <!-- NonogramGameScreen: Shown when no fair puzzle could be generated for this level. Sentence -->
    <string name="generation_failed">Could not build a puzzle for this level.</string>
    <!-- NonogramGameScreen: Retries generation after a failure, and the level after running out of hearts. Verb -->
    <string name="try_again">Try Again</string>

    <!-- NonogramBoard: Content description of a cell. %1$d = row number starting at 1, e.g. 4. %2$d = column number starting at 1, e.g. 6. %3$s = the cell's state word, e.g. Filled -->
    <string name="cd_cell">Row <xliff:g id="row" example="4">%1$d</xliff:g>, column <xliff:g id="column" example="6">%2$d</xliff:g>, <xliff:g id="state" example="Filled">%3$s</xliff:g></string>
    <!-- NonogramBoard: Cell state, painted as part of the picture. Verb past participle -->
    <string name="cd_filled">Filled</string>
    <!-- NonogramBoard: Cell state, ruled out by the player. Verb past participle -->
    <string name="cd_crossed">Crossed out</string>
    <!-- NonogramBoard: Cell state, untouched. Adjective -->
    <string name="cd_blank">Blank</string>
</resources>
