    <string name="app_name" translatable="false">Logic Gate</string>

    <!-- MainActivity: Loading state when level data not yet ready from DataStore. Verb progressive -->
    <string name="loading">Loading…</string>
    <!-- GameScreen win dialog: Title shown when the level is solved. Noun phrase -->
    <string name="level_complete_title">Level Complete!</string>
    <!-- GameScreen win dialog: Body. %1$s = level name, e.g. XOR. Sentence -->
    <string name="level_complete_body">You solved <xliff:g id="level_name" example="XOR">%1$s</xliff:g>.</string>
