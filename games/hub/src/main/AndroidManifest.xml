<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.vayunmathur.games.hub.permission.READ_GAME_DATA"
        android:protectionLevel="signature" />
    <permission
        android:name="com.vayunmathur.games.hub.permission.WRITE_GAME_DATA"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.vayunmathur.games.chess" />
        <package android:name="com.vayunmathur.games.alchemist" />
        <package android:name="com.vayunmathur.games.pipes" />
        <package android:name="com.vayunmathur.games.solitaire" />
        <package android:name="com.vayunmathur.games.unblockjam" />
        <package android:name="com.vayunmathur.games.wordmaker" />
        <package android:name="com.vayunmathur.games.logicgate" />
        <package android:name="com.vayunmathur.games.voxels" />
        <package android:name="com.vayunmathur.games.sudoku" />
        <package android:name="com.vayunmathur.games.minesweeper" />
        <package android:name="com.vayunmathur.games.nonogram" />
        <package android:name="com.vayunmathur.games" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:backupAgent=".util.AppBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">

        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".provider.GamesHubProvider"
            android:authorities="com.vayunmathur.games.hub.provider"
            android:exported="true"
            android:readPermission="com.vayunmathur.games.hub.permission.READ_GAME_DATA"
            android:writePermission="com.vayunmathur.games.hub.permission.WRITE_GAME_DATA" />

        <provider
            android:name=".provider.GamesHubLegacyProvider"
            android:authorities="com.vayunmathur.games.provider"
            android:exported="true"
            android:readPermission="com.vayunmathur.games.hub.permission.READ_GAME_DATA"
            android:writePermission="com.vayunmathur.games.hub.permission.WRITE_GAME_DATA" />

    </application>

</manifest>
