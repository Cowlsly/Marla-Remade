<?xml version="1.0" encoding="utf-8"?>
<!--
  Solitaire. Audited state: the "solitaire_stats" SharedPreferences file
  (SolitaireStatsRepository / AppBackupAgent.prefNames) holding win counts, best
  times and streaks, plus filesDir/datastore_default.preferences_pb, the shared
  DataStoreUtils file holding the AchievementsManager unlocks. No Room database
  and nothing written to external storage; achievements.json is a read-only APK
  asset.

  Back everything up - lifetime stats are the thing a solitaire player would be
  most annoyed to lose.

  SCOPE: solitaire declares android:backupAgent=".platform.AppBackupAgent" and
  does NOT set android:fullBackupOnly, so Android uses key/value backup and the
  <cloud-backup> section below is NOT consulted. Cloud content is exactly
  AppBackupAgent's prefNames = ["solitaire_stats"] plus datastoreNames =
  ["datastore_default"], which is the same data this file would have sent.
  <device-transfer> IS governed here, and these rules become the cloud control
  too if the backupAgent is ever removed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
