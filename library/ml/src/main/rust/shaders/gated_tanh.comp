#version 450
//! WaveNet's gated activation: `out[c] = tanh(in[c]) * sigmoid(in[c + C])`.
//!
//! The input carries twice the output's channels — a "filter" half and a "gate" half, which
//! a single convolution produces together and this splits. 16 uses in Piper's flow, four in
//! each of its four coupling layers.
//!
//! # Why it is one op and not three
//!
//! `tanh` and `sigmoid` both exist as fusable activations, so this could be a convolution
//! with a `Tanh`, another with a `Sigmoid` and an elementwise multiply. It is one op because
//! the two halves come from the *same* convolution: splitting them would mean either running
//! that convolution twice or materialising a `[2C, 1, T]` tensor and reading it twice. One
//! pass that reads both halves and writes one is strictly less work and less arena.
//!
//! The export spells it as a `Slice`, a `Slice`, a `Tanh`, a `Sigmoid` and a `Mul`, and
//! leaves the two `Slice`s' outputs as separate tensors. Nothing is lost by fusing: the
//! halves are never read again.

#include "common.glsl"

void main() {
    uint index = global_index();
    if (index >= p.count) {
        return;
    }
    // `p.out_c` channels out, so the gate half starts this many elements on.
    uint gate_at = p.out_c * p.out_h * p.out_w;
    float filtered = float(arena[p.in0 + index]);
    float gate = float(arena[p.in0 + gate_at + index]);
    arena[p.out_at + index] = float16_t(tanh(filtered) / (1.0 + exp(-gate)));
}
