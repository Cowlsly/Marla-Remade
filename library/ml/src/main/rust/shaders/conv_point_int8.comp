#version 450
//! `conv_point.comp` with int8 weights, dequantised by one scale per output channel.
//!
//! `out[o][p] = act(scale[o] * sum_i W[o][i] * in[i][p] + bias[o])`, `p` over positions.
//!
//! # Why this exists as well as `conv_int8.comp`
//!
//! `conv_int8.comp` is shaped like `conv.comp`: one invocation per output element, each reading
//! its own weight row from global memory with no reuse. That is survivable for a spatial kernel
//! and catastrophic for a wide `1 x 1` over a short sequence — the same 15.2 GFLOP/s against a
//! device peak of order 1000 that `conv_point.comp` exists to fix.
//!
//! Supertonic's sampler is 92% pointwise convolution by parameter count and runs `2 * STEPS`
//! times per utterance, so quantising it onto the untiled path would move almost all of its work
//! onto the slow one and take text-to-speech past real time. Quantising is a size win only if the
//! tiled shape has an int8 form, which is this.
//!
//! # What differs from `conv_point.comp`
//!
//! Two lines, and nothing structural. The weight tile is staged from `int8_at` through the 32-bit
//! view of the weights buffer rather than read as fp16, and the finished accumulator is scaled
//! before the bias is added. Everything else — the tiling, the 2 x 2 register blocking, both
//! barriers — is that shader unchanged; see it for why the tiling is shaped the way it is.
//!
//! The scale is per **output channel**, which is the tile's row axis, so an invocation's two rows
//! carry two scales and each applies to a whole finished accumulator. A per-input-channel scale
//! could not be hoisted out of the inner loop this way.
//!
//! `p.weight` is a **32-bit word** offset, as in `conv_int8.comp`. `p.act_weight` holds the scale
//! tensor as an fp16 element index, which is why `Act::PRelu` cannot ride along.

#include "common.glsl"

/// Output channels and positions per workgroup, and input channels per staging step.
#define TILE 16u

/// The staged blocks. `TILE * TILE` each, so 2 KB of shared memory at fp32.
shared float weight_tile[TILE][TILE];
shared float input_tile[TILE][TILE];

void main() {
    // The tile this workgroup owns. Uniform across the workgroup, so returning early cannot
    // strand a barrier — every invocation takes the same branch.
    uint tile = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (tile >= p.count) {
        return;
    }
    uint positions = p.out_h * p.out_w;
    uint tiles_across = (positions + TILE - 1u) / TILE;
    uint channel_base = (tile / tiles_across) * TILE;
    uint position_base = (tile % tiles_across) * TILE;

    // This invocation's 2 x 2 corner of the tile.
    uint lid = gl_LocalInvocationID.x;
    uint local_row = (lid >> 3u) * 2u;
    uint local_col = (lid & 7u) * 2u;

    float acc[2][2] = { { 0.0, 0.0 }, { 0.0, 0.0 } };

    for (uint k0 = 0u; k0 < p.in_c; k0 += TILE) {
        // Stage both blocks. 256 elements each, 64 invocations, so four apiece. Out-of-range
        // entries are zeroed rather than skipped, which lets the inner loop run unguarded.
        for (uint n = 0u; n < 4u; n++) {
            uint slot = lid + n * 64u;
            uint r = slot >> 4u;
            uint c = slot & 15u;

            uint channel = channel_base + r;
            uint k_weight = k0 + c;
            weight_tile[r][c] = (channel < p.out_c && k_weight < p.in_c)
                ? float(int8_at(p.weight, channel * p.in_c + k_weight))
                : 0.0;

            uint k_input = k0 + r;
            uint position = position_base + c;
            input_tile[r][c] = (k_input < p.in_c && position < positions)
                ? float(arena[p.in0 + k_input * positions + position])
                : 0.0;
        }
        barrier();

        for (uint k = 0u; k < TILE; k++) {
            float a0 = weight_tile[local_row][k];
            float a1 = weight_tile[local_row + 1u][k];
            float b0 = input_tile[k][local_col];
            float b1 = input_tile[k][local_col + 1u];
            acc[0][0] += a0 * b0;
            acc[0][1] += a0 * b1;
            acc[1][0] += a1 * b0;
            acc[1][1] += a1 * b1;
        }
        // Both barriers are needed: the second stops the next step's staging from overwriting
        // tiles an invocation is still reading.
        barrier();
    }

    for (uint i = 0u; i < 2u; i++) {
        uint channel = channel_base + local_row + i;
        if (channel >= p.out_c) {
            continue;
        }
        float scale = float(weights[p.act_weight + channel]);
        float offset = float(weights[p.bias + channel]);
        for (uint j = 0u; j < 2u; j++) {
            uint position = position_base + local_col + j;
            if (position >= positions) {
                continue;
            }
            float value = activate(acc[i][j] * scale + offset, p.act, channel);
            arena[p.out_at + channel * positions + position] = float16_t(value);
        }
    }
}
