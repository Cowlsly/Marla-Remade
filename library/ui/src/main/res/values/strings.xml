    <!-- Shared library: UI – BackupButtons: Prompt above password TextField asking user to enter master password for KDBX file -->
    <string name="backup_password_prompt">Enter a master password for the KDBX file:</string>
    <!-- Shared library: UI – BackupButtons: Confirm button in password dialog, label OK, enabled only when password non-empty -->
