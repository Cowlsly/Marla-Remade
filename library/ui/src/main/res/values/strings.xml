    <string name="backup_import_success">Backup imported successfully. Please restart the app.</string>
    <!-- Shared library: UI – BackupButtons: Toast when import fails. %1$s = raw exception message, do not translate placeholder content -->
    <string name="backup_import_failed_format">Backup import failed: <xliff:g id="error" example="invalid file">%1$s</xliff:g></string>
