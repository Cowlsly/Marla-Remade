<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name: launcher label, appears in app drawer. Also the Home screen title -->
    <string name="app_name">Things</string>

    <!-- Devices screen title: device management (scan/connect/disconnect). Noun -->
    <string name="devices">Devices</string>
    <!-- Home empty state when no device has been added yet. Sentence -->
    <string name="no_devices">No devices added</string>
    <!-- Button on Home empty state that opens the Add device screen. Verb phrase -->
    <string name="open_devices">Open Devices</string>
    <!-- Add device screen title, and the button that opens it. Verb phrase -->
    <string name="add_device">Add device</string>
    <!-- Large button on the Add device screen, starts a scan for a smart water bottle. Verb phrase -->
    <string name="connect_new_bottle">Connect new water bottle</string>
    <!-- Large button on the Add device screen, starts a scan for a body scale. Verb phrase -->
    <string name="connect_new_scale">Connect new scale</string>
    <!-- Title of the dialog listing devices found by the scan. Verb phrase -->
    <string name="select_device">Select a device</string>
    <!-- Shown in the device picker while the scan is still running. Sentence -->
    <string name="searching">Searching…</string>
    <!-- Shown in the device picker when the scan finished with no results. Sentence -->
    <string name="no_devices_found">No devices found</string>
    <!-- Button on a device card that unpairs it and stops reconnecting. Verb phrase -->
    <string name="forget_device">Forget device</string>
    <!-- Dismiss button on the device picker dialog. Verb -->
    <string name="cancel">Cancel</string>
    <!-- Scale note reassuring that measurements are saved to Health Connect. Sentence -->
    <string name="syncs_to_health_connect">Measurements sync to Health Connect</string>

    <!-- Button to start BLE scan for smart bottle/cup. Verb, short action label -->
    <string name="scan">Scan</string>
    <!-- Device list label when BLE devices discovered. Noun phrase, colon intentional -->
    <string name="devices_found">Devices found:</string>
    <!-- Button to disconnect from BLE device. Verb -->
    <string name="disconnect">Disconnect</string>
    <!-- Bottle status section header shown when connected and sensor values available -->
    <string name="bottle_status">Bottle status</string>
    <!-- Row labels in the bottle status card -->
    <string name="label_battery">Battery</string>
    <string name="label_water_level">Water level</string>
    <string name="label_temperature">Temperature</string>
    <string name="label_purity">Purity</string>
    <!-- Generic percentage value. %1$d = 0-100 -->
    <string name="percent"><xliff:g id="pct" example="60">%1$d</xliff:g>%%</string>
    <!-- Shown in the bottle card before the first sensor reading arrives -->
    <string name="waiting_for_data">Waiting for data…</string>
    <!-- Timestamp of the most recent sensor reading. %1$s = clock time e.g. 14:05:30 -->
    <string name="last_updated">Updated <xliff:g id="time" example="14:05:30">%1$s</xliff:g></string>
    <!-- Bottle status: water temperature. %1$d = degrees Celsius integer -->
    <string name="temperature_c"><xliff:g id="temp" example="22">%1$d</xliff:g>°C</string>
    <!-- Bottle status: water purity as TDS. %1$d = ppm integer -->
    <string name="purity_ppm"><xliff:g id="tds" example="85">%1$d</xliff:g> ppm</string>
    <!-- Bottle status: battery level. %1$d = percent 0-100 -->
    <string name="battery_pct"><xliff:g id="pct" example="75">%1$d</xliff:g>%%</string>
    <!-- Bottle status: battery level while charging. %1$d = percent 0-100 -->
    <string name="battery_charging"><xliff:g id="pct" example="75">%1$d</xliff:g>%% (charging)</string>

    <!-- Scale section -->
    <!-- Scale section title. Noun -->
    <string name="scale_title">Body Scale</string>
    <!-- Scale section subtitle. Explains offline BLE -->
    <string name="scale_subtitle">Renpho Elis 1 — offline BLE, no cloud</string>
    <!-- Scale profile header -->
    <string name="scale_profile">Profile</string>
    <!-- Sex options -->
    <string name="sex_male">Male</string>
    <string name="sex_female">Female</string>
    <!-- Profile fields -->
    <string name="age">Age</string>
    <string name="height_cm">Height (cm)</string>
    <string name="athlete">Athlete mode</string>
    <!-- Scale scan button -->
    <string name="scan_scale">Scan scale</string>
    <!-- Health Connect -->
    <!-- Button to grant Health Connect permissions. Verb phrase -->
    <string name="health_connect">Health Connect</string>

    <!-- First-run permission screen -->
    <!-- Headline on the first-run permission screen. Sentence -->
    <string name="permissions_title">Permissions needed</string>
    <!-- Explains why the app cannot start without both permissions. Sentence -->
    <string name="permissions_rationale">Things reads your bottle and scale over Bluetooth and saves the readings to Health Connect. It needs both to work.</string>
    <!-- Name of the Bluetooth permission on the first-run screen. Noun -->
    <string name="permission_bluetooth">Bluetooth</string>
    <!-- Why the app needs Bluetooth. Sentence -->
    <string name="permission_bluetooth_reason">To find and stay connected to your water bottle and body scale.</string>
    <!-- Name of the Health Connect permission on the first-run screen. Noun -->
    <string name="permission_health_connect">Health Connect</string>
    <!-- Why the app needs Health Connect. Sentence -->
    <string name="permission_health_connect_reason">To save your hydration and body measurements. This app stores nothing itself.</string>
    <!-- Shown on a permission card once the permission has been granted. Adjective -->
    <string name="permission_granted">Granted</string>
    <!-- Button that asks the system for a permission. Verb -->
    <string name="permission_grant">Grant</string>
    <!-- Shown when a permission was permanently denied and can only be changed in settings -->
    <string name="permission_blocked">This has to be turned on in system settings.</string>
    <!-- Button that opens this app's page in system settings. Verb phrase -->
    <string name="permission_open_settings">Open settings</string>

    <!-- Foreground service -->
    <!-- Notification channel name for the ongoing "keeping devices connected" notification -->
    <string name="device_channel_name">Device connection</string>
    <!-- Notification channel description shown in system notification settings -->
    <string name="device_channel_desc">Keeps your bottle and scale connected in the background</string>
    <!-- Ongoing foreground-service notification title -->
    <string name="device_notification_title">Devices connected</string>
    <!-- Ongoing foreground-service notification body text -->
    <string name="device_notification_text">Keeping your devices connected</string>
</resources>
