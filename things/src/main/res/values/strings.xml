<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name: launcher label, appears in app drawer -->
    <string name="app_name">Things</string>

    <!-- TopAppBar title. Noun, refers to hydration tracking feature -->
    <string name="hydration">Hydration</string>
    <!-- HydrationCard: header label for today's total intake. Noun/adjective, Title Case -->
    <string name="today">Today</string>
    <!-- Button to start BLE scan for smart bottle/cup. Verb, short action label -->
    <string name="scan">Scan</string>
    <!-- Device list label when BLE devices discovered. Noun phrase, colon intentional -->
    <string name="devices_found">Devices found:</string>
    <!-- Button to disconnect from BLE device. Verb -->
    <string name="disconnect">Disconnect</string>
    <!-- Section header above daily drink log LazyColumn. Noun phrase -->
    <string name="today_s_drinks">Today\'s drinks</string>
    <!-- HydrationCard: total consumed. %1$s = volume number e.g. 450. Keep mL unit after placeholder -->
    <string name="ml"><xliff:g id="volume" example="450">%1$s</xliff:g> mL</string>
    <!-- HydrationCard: daily goal beneath progress bar. %1$s = goal number e.g. 2000 -->
    <string name="goal_ml">Goal <xliff:g id="goal" example="2000">%1$s</xliff:g> mL</string>
    <!-- Bottle status section header shown when connected and sensor values available -->
    <string name="bottle_status">Bottle status</string>
    <!-- Bottle status: water temperature. %1$d = degrees Celsius integer -->
    <string name="temperature_c"><xliff:g id="temp" example="22">%1$d</xliff:g>°C</string>
    <!-- Bottle status: water purity as TDS. %1$d = ppm integer -->
    <string name="purity_ppm"><xliff:g id="tds" example="85">%1$d</xliff:g> ppm</string>
    <!-- Bottle status: battery level. %1$d = percent 0-100 -->
    <string name="battery_pct"><xliff:g id="pct" example="75">%1$d</xliff:g>%%</string>
    <!-- Bottle status: battery level while charging. %1$d = percent 0-100 -->
    <string name="battery_charging"><xliff:g id="pct" example="75">%1$d</xliff:g>%% (charging)</string>

