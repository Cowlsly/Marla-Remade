<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Navigation foreground service requires the LOCATION subtype on Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Required on Android 13+ to show the navigation notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Live family-location channel (P18): bind findfamily's exported bound
         service. Signature-level, so it is granted only because both MA apps
         share the signing key; on any other signer it is simply not granted and
         the family-pins feature is absent. -->
    <uses-permission android:name="com.vayunmathur.findfamily.permissions.ACCESS_FAMILY" />

    <!-- Voice search (P8): records audio for the system SpeechRecognizer, which
         routes to the user-selected recognition service (the MA speech app when
         installed). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Contact address shortcut (P17): fallback only. The system postal-address
         picker grants an implicit per-row read, so this is requested at runtime
         solely when an OEM refuses that read; the common path needs no grant. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Android 11+ package visibility: needed so SpeechRecognizer can see and
         bind the installed on-device recognition service for voice search. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Resolve the system postal-address picker (ACTION_PICK over the
             Contacts provider) for the P17 contact address shortcut. -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/postal-address_v2" />
        </intent>
        <!-- Android 11+ package visibility: resolve + bind findfamily's live
             family-location service (P18) by its action. -->
        <intent>
            <action android:name="com.vayunmathur.findfamily.action.FAMILY_LOCATIONS" />
        </intent>
    </queries>


    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <activity
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live navigation foreground service. Owns the ongoing
             progress notification and keeps GPS streaming while the
             app is backgrounded or the screen is off. -->
        <service
            android:name=".util.NavigationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Android Auto (P12): the Car App Library entry point. The host
             (Android Auto, projected) binds this CarAppService via the
             androidx.car.app.CarAppService action; the NAVIGATION category
             marks it as a turn-by-turn navigation app so it may draw to the
             car Surface and use the NavigationTemplate. The map/nav session
             reuses the existing routing + NavigationSessionManager + system
             TTS stack; the phone UI (MainActivity) is unaffected. -->
        <service
            android:name=".car.MapsCarAppService"
            android:exported="true"
            android:foregroundServiceType="location">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Minimum Car App API level this app targets (Car App Library). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Declares this app to the Android Auto host as a template app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>