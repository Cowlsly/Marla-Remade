<?xml version="1.0" encoding="utf-8"?>
<!--
  Calculator. Audited state: the converter's last-used tab and unit pair, written
  through the shared DataStoreUtils into file/datastore_default.preferences_pb.
  Everything else (calculation history, graphed functions, the memory register) is
  held in Compose state and is gone when the process dies.
  The rules include whole domains rather than that one file so that if further
  persistence is added later it is covered by default instead of being silently
  dropped.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
