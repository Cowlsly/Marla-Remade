<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Local Network Protections (Android 16+): without this NsdManager.discoverServices throws
         SecurityException and every LAN socket is blocked, so the device list is silently empty. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AudioRecord needs this even for playback capture, where no microphone is involved: the
         permission gates the API, not the source. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Both halves of RemoteDisplayProviderWatcher.verifyServiceTrusted: the app must hold
         REMOTE_DISPLAY_PROVIDER and the service must be guarded by BIND_REMOTE_DISPLAY. Failing
         either one is not an error the user sees - the watcher logs and skips the service, and the
         Cast page is simply empty. Signature|privileged, so it needs the priv-app allowlist entry
         in vendor/modern-apps/privapp-permissions-modern-apps.xml. -->
    <uses-permission android:name="android.permission.REMOTE_DISPLAY_PROVIDER" />
    <!-- Selecting a route in Settings has to end at MirrorConsentActivity, because screen-capture
         consent needs an Activity and is single-use. By then Settings is in front and this app is a
         bound service in the background, so without this the launch is silently dropped and the
         route sits at CONNECTING for ever. protectionLevel is
         signature|privileged|vendorPrivileged|oem|verifier|role, so the priv-app allowlist entry is
         what grants it - this app is presigned with its own key, not the platform key.
         CAPTURE_VIDEO_OUTPUT, which would let a VirtualDisplay mirror with no consent Activity at
         all, is signature-only and therefore unreachable for a presigned app. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />

    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <permission
        android:name="com.vayunmathur.cast.permission.STREAM_CONTENT"
        android:label="@string/cast_stream_content_permission_label"
        android:description="@string/cast_stream_content_permission_desc"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.General">
        <!-- The remote display provider API is a shared library, not part of the base framework.
             Optional so the app still installs on a stock device, where nothing binds
             CastRemoteDisplayService anyway. -->
        <uses-library
            android:name="com.android.media.remotedisplay"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.General">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".platform.mirror.MirrorConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".platform.CastPickerActivity"
            android:configChanges="mcc|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.vayunmathur.cast.permission.STREAM_CONTENT"
            android:theme="@style/Theme.General" />

        <service
            android:name=".service.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|mediaPlayback" />

        <!-- Bound by system_server's RemoteDisplayProviderWatcher, which is what puts this app's
             receivers in Settings' Cast page. BIND_REMOTE_DISPLAY is required by the watcher, not
             merely prudent - see MaRemoteDisplayProvider. -->
        <service
            android:name=".service.CastRemoteDisplayService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTE_DISPLAY">
            <intent-filter>
                <action android:name="com.android.media.remotedisplay.RemoteDisplayProvider" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ContentCastService"
            android:exported="true"
            android:permission="com.vayunmathur.cast.permission.STREAM_CONTENT" />

        <service
            android:name=".platform.mirror.MirrorTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_cast_mirror"
            android:label="@string/cast_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVITY"
                android:value="com.vayunmathur.cast.MainActivity" />
        </service>
    </application>
</manifest>
