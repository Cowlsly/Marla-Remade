    <string name="tv_mirroring">Receiving from %1$s</string>
    <string name="tv_no_decoder">This TV has no usable H.264 decoder</string>
    <string name="tv_stream_failed">The stream stopped</string>

    <!-- Foreground service -->
    <string name="tv_notification_channel_name">Receiving</string>
    <string name="tv_notification_channel_desc">Shown while this TV is available to cast to</string>
